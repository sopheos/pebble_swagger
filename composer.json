{
    "name": "sopheos/pebble_swagger",
    "description": "OpenAPI 3 document generator from oa-* docblock tags",
    "license": "MIT",
    "require": {
        "php": ">=8.1.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Pebble\\Swagger\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
